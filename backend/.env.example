# Environment Variables — PhishGuard Backend
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Phase 7 - fill in when setting up MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/phishguard

# CORS — extension origin (chrome-extension://YOUR_EXTENSION_ID)
ALLOWED_ORIGIN=*

# Optional: Threat Intelligence API key (Phase 9)
# VIRUSTOTAL_API_KEY=your_key_here
